<%- include('partials/headers') %>
    <main>

        <h1><%= title %></h1>
        <form action ="/rooms/add" method="post">
            <p>
                <label for="name">Room Name:</label>
                <input type="text" name="name" id="name" required>
            </p>
            <p>
                <label for="building">Building:</label>
                <input type="text" name="building" id="building" required>
            </p>
            <p>
                <label for="roomNumber">Room Number:</label>
                <input type="text" name="roomNumber" id="roomNumber" required>
            </p>
            <p>
                <label for="capacity">Capacity:</label>
                <input type="number" name="capacity" id="capacity" min="1" required>
            </p>
            <p>
                <label for="noiseLevel">Noise Level:</label>
                <select name="noiseLevel" id="noiseLevel" required>
                    <option value="">choose a noice level</option>
                    <option value="Quiet">Quiet</option>
                    <option value="Moderate">Moderate</option>
                    <option value="Loud">Loud</option>
                </select>
            </p>
            
                <button type="submit">Save Room</button>
                <a href="/rooms">Cancel</a>
        

            
        </form>
    </main>
    <%- include('partials/footer') %>