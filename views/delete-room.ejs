<%- include('partials/headers') %>
    <main>
        <h1><%= title %></h1>
        <p>Are you sure you want to delete this room <strong><%= room.name %></strong> in <strong><%= room.building %></strong>, Room <strong><%= room.roomNumber %></strong>?
        </p>
        <form action="/rooms/<%= room._id %>/delete" method="post">
            <button type="submit">yes, delete room</button>
            <a href="/rooms">cancel</a>
        </form>
    </main>
    <%- include('partials/footer') %>