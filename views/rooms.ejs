<%- include('partials/headers') %>

<main>
    <h1><%= title %></h1>
    <p><a href="/rooms/add" class="btn btn-primary">Add room</a></p>
    <% if (rooms.length === 0) { %>
        <p>There are no rooms available at the moment.</p>
    <% } %>
        <% for (let i=0; i < rooms.length; i++) { %>
        <article class="room-door">
            <h2><%= rooms[i].name %></h2>
            <p><%= rooms[i].building %>, Room <%= rooms[i].roomNumber %></p>
        <p>Seats: <%= rooms[i].capacity %></p>
        <p class="door-sign">
            <% if (rooms[i].noiseLevel === 'Quiet') { %>
                <i class="fa-solid fa-volume-off" aria-hidden="true"></i>
            <% } else if (rooms[i].noiseLevel === 'Moderate') { %>
                <i class="fa-solid fa-volume-low" aria-hidden="true"></i>
            <% } else if (rooms[i].noiseLevel === 'Loud') { %>
                <i class="fa-solid fa-volume-high" aria-hidden="true"></i>
            <% } %>
            <%= rooms[i].noiseLevel %>
            </p>
            
        <p>Status: <%= rooms[i].available ? 'Available' : 'In use' %></p>
        
        <form action="/rooms/<%= rooms[i]._id %>/availability" method="post">
            <% if (rooms[i].available) { %>
                <button type="submit" name="available" value="false">claim</button>
            <% } else { %>
                <button type="submit" name="available" value="true">unclaim</button>
            <% } %>
        </form>
            <p><a href="/rooms/<%= rooms[i]._id %>/edit">Edit room</a></p>
            <p><a href="/rooms/<%= rooms[i]._id %>/delete">Delete room</a></p>
    
        </article>
        <% } %>
</main>

<%- include('partials/footer') %>